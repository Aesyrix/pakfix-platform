###############################################################################
# PakFix.pk — Backend (Laravel API) environment
# Copy to .env and fill in. NEVER commit a real .env.
###############################################################################

APP_NAME=PakFix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The Next.js application. Used for CORS, Sanctum, e-mail links and redirects.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

###############################################################################
# Database — PostgreSQL in every real environment.
# Set DB_CONNECTION=sqlite for a zero-dependency local spin-up (see README).
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pakfix
DB_USERNAME=pakfix
DB_PASSWORD=secret

###############################################################################
# Cache / queue / session — Redis in production
###############################################################################
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

###############################################################################
# Filesystem — local disk in dev, S3-compatible in production
###############################################################################
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@pakfix.pk"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# AI — the active provider is resolved at runtime and is overridable
# from the admin dashboard (settings table wins over these defaults).
###############################################################################
AI_PROVIDER=openai
AI_ENABLED=true
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1500
AI_FREE_DIAGNOSES_PER_DAY=5
AI_REQUEST_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

###############################################################################
# Maps
###############################################################################
GOOGLE_MAPS_KEY=
GOOGLE_PLACES_KEY=
GOOGLE_GEOCODING_KEY=
GOOGLE_DISTANCE_MATRIX_KEY=

###############################################################################
# Payments — every gateway is optional; cash-on-service always works.
###############################################################################
PAYMENTS_DEFAULT_GATEWAY=cash
PLATFORM_COMMISSION_PERCENT=10
PLATFORM_TAX_PERCENT=0

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=

EASYPAISA_STORE_ID=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=

###############################################################################
# Messaging channels (architecture-ready; disabled until credentials exist)
###############################################################################
SMS_ENABLED=false
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=PakFix

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

PUSH_ENABLED=false
FCM_SERVER_KEY=

###############################################################################
# Uploads
###############################################################################
UPLOAD_MAX_IMAGE_KB=8192
UPLOAD_MAX_VIDEO_KB=51200
UPLOAD_MAX_DOCUMENT_KB=10240

VITE_APP_NAME="${APP_NAME}"
