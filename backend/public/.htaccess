# PakFix — Apache configuration for the public/ web root.
#
# Real files (the built website's JavaScript, CSS, icons, sitemap) are served
# straight from disk. Everything else -- every page URL and every /api call --
# goes to Laravel, which maps clean URLs onto the built HTML.

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # One URL per page: /services/ redirects to /services.
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send everything that is not a real file to Laravel. Directories are
    # included on purpose: /services is a page, even though the build also
    # creates a services/ folder.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Build assets have content hashes in their names, so they never change
    # under the same URL and can be cached for a year.
    <If "%{REQUEST_URI} =~ m#^/_next/static/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
